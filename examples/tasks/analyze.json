{
  "format": "moonmmdb-task",
  "version": 1,
  "operation": "analyze",
  "parameters": {
    "ip_path": "/ip",
    "top": 10,
    "max_groups": 10000,
    "max_records": 10000,
    "max_input_bytes": 8388608,
    "max_line_bytes": 8388608,
    "max_json_depth": 128,
    "diagnostic_limit": 100
  },
  "files": [
    {
      "role": "city",
      "name": "city.mmdb"
    },
    {
      "role": "asn",
      "name": "asn.mmdb"
    },
    {
      "role": "input",
      "name": "access.jsonl"
    }
  ]
}
